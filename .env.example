# Copy to .env. Never commit the filled file.
DOMAIN=app.example.com
PUBLIC_URL=https://app.example.com
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Preserve this key in your secrets manager and backups; changing it locks saved user API keys.
CLOUD_ENCRYPTION_KEY=
CLOUD_DATA_DIR=.data/cloud
# Production registration requires transactional email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LensDesk <accounts@example.com>
# A recurring Stripe Price ID determines the actual amount and interval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Prepaid INR plans for the LensDesk desktop application (no auto-renewal).
# Create these in the Razorpay dashboard and point the webhook at
# https://<your-domain>/api/purchase.webhook with payment.captured and
# refund.processed (payment.failed is also supported; other refund.* events
# follow the same verified path).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional catalog override (JSON array) and tax note shown on the website.
# Leave empty to use Hourly ₹100 / Daily ₹200 / 10-Day ₹1,000 / Monthly ₹1,500.
PLANS_JSON=
PLAN_TAX_NOTE=Inclusive of applicable taxes.
# Website operator console at /?admin. Leave empty to disable it (endpoints 404).
# Generate a long random value; it is sent only as an Authorization: Bearer header.
ADMIN_TOKEN=
# Serve release artifacts from this directory.
DOWNLOAD_DIRECTORY=release
# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Desktop client heartbeat interval and offline tolerance, in seconds.
LENSDESK_HEARTBEAT_SECONDS=60
LENSDESK_OFFLINE_GRACE_SECONDS=120
# Optional operator-funded AI access. Users may alternatively supply their own keys.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Restrict models that may use operator-funded keys. Defaults to the bundled model for each provider.
HOSTED_MODEL_ALLOWLIST={}
FREE_DAILY_TOKENS=100000
PRO_DAILY_TOKENS=2000000
# Optional separate operator token for GET /ops/metrics. Keep it private and distinct from account credentials.
OPERATOR_TOKEN=
