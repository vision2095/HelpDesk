#include <windows.h>

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LensDesk Team\0"
            VALUE "FileDescription",  "LensDesk 2.0 Native Windows Host\0"
            VALUE "FileVersion",      "2.0.0.0\0"
            VALUE "InternalName",     "RuntimeHost\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 LensDesk. All rights reserved.\0"
            VALUE "OriginalFilename", "RuntimeHost.exe\0"
            VALUE "ProductName",      "LensDesk 2.0\0"
            VALUE "ProductVersion",   "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
